<?xml version="1.0" encoding="utf-8"?>
<!--
  No policies declared on purpose. Registering as a device admin at all is
  what makes uninstall require a detour through Settings first (see
  ClearGuardDeviceAdminReceiver). ClearGuard doesn't need any of the
  actual device-management policies (password limits, camera disable,
  login watching, etc.), and declaring ones it doesn't use would just be
  unjustified privilege for a Play Store review.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies />
</device-admin>
